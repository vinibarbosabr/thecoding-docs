{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Vini B | thecoding",
  "colors": {
    "primary": "#042F2E",
    "light": "#FFF3CE",
    "dark": "#008BBE"
  },
  "description": "Vini B @ thecoding turns complex developer and security topics into content and documentation people understand, use, and share.",
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/logo.png",
    "dark": "/logo/logo-dark.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "Start",
        "pages": [
          "index",
          "quickstart",
          "pricing"
        ]
      },
      {
        "group": "Work",
        "pages": [
          "endorsements"
        ]
      },
      {
        "group": "Services",
        "pages": [
          "documentation"
        ]
      },
      {
        "group": "Engage",
        "pages": [
          "contact"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Personal Account",
          "href": "https://x.com/vinibarbosabr",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Substack Publication",
          "href": "https://thecoding.substack.com",
          "icon": "newspaper"
        }
      ]
    }
  },
  "redirects": [
    {
      "source": "/devrel",
      "destination": "/developer-education"
    },
    {
      "source": "/technical-writing",
      "destination": "/developer-education"
    }
  ],
  "navbar": {
    "links": [
      {
        "label": "Book a 20-minute briefing",
        "href": "https://cal.com/vinib"
      }
    ],
    "primary": {
