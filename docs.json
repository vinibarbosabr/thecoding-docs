  },
  "footer": {
    "socials": {
      "x": "https://x.com/vinibarbosabr",
      "github": "https://github.com/vinibarbosabr",
      "linkedin": "https://linkedin.com/company/thecoding"
    },
    "links": [
      {
        "header": "More",
        "items": [
          {
            "label": "Resume",
            "href": "/resume"
          },
          {
            "label": "Staking",
            "href": "/staking"
          },
          {
            "label": "Terms",
